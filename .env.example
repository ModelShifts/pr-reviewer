# pr-reviewer configuration. Copy to .env and edit.
# Placeholder values only. Never commit real keys.

# Choose a backend: "api" (any OpenAI-compatible endpoint) or "hf" (open model via transformers)
MS_BACKEND=hf

# --- (a) api: bring your own key, any OpenAI-compatible endpoint ---
MS_API_BASE=https://your-provider.example/v1
MS_API_KEY=your-api-key
MS_MODEL=your-code-model

# --- (b) hf: an open model from Hugging Face, run locally with transformers ---
# Qwen2.5-Coder-7B-Instruct needs a GPU or a lot of memory.
# On a CPU-only machine use the 1.5B model.
MS_HF_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
# MS_HF_MODEL=Qwen/Qwen2.5-Coder-1.5B-Instruct
# HF_TOKEN=your-hf-token   # only needed for gated models

# --- shared ---
# Reply length for each model call
MS_MAX_NEW_TOKENS=512
# Where the web demo keeps saved results
MS_CACHE_DIR=.cache/reviews

# Optional: ModelShifts/jira-bridge. Used only when jira.enabled is true
# in .github/pr-reviewer.yml. See that project's README for the config file.
# JIRA_BRIDGE_CONFIG=~/.config/modelshifts/jira.json
